<?xml version="1.0" encoding="utf-8"?>
<!-- Android < 12: nothing is backed up. Shop data is restored from the Dokan cloud instead,
     and local secrets (PINs, license, support keys) must never leave the phone. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
