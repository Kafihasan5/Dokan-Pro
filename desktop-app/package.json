{
  "name": "dokan-pro-desktop",
  "private": true,
  "version": "1.0.117",
  "description": "Dokan Pro point of sale and store management desktop app",
  "author": "Webix Solution",
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.webix.dokanpro.desktop",
    "productName": "Dokan Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/icon.ico",
        "to": "build-resources/icon.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:desktop": "npm run build && electron-builder --mac dmg --arm64",
    "build:desktop:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "build:desktop:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "build:desktop:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
